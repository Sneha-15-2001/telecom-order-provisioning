# Copy this file to .env and adjust values locally. Never commit .env.
# Used by all five microservices (see each service's src/main/resources/application.yml).

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Per-service databases (one database per service, no cross-service table access)
CUSTOMER_DB_NAME=telecom_customer
ORDER_DB_NAME=telecom_order
INVENTORY_DB_NAME=telecom_inventory
PROVISIONING_DB_NAME=telecom_provisioning
NOTIFICATION_DB_NAME=telecom_notification

# Service ports
CUSTOMER_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
INVENTORY_SERVICE_PORT=8083
PROVISIONING_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# Frontend
ANGULAR_PORT=4200
